    "pg": "catalog:",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "stripe": "^22.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "catalog:",
    "@types/express": "^5.0.3",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
