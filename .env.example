#############################################################################
# captures-by-capri — copy to .env and fill in.
#
# One .env at the repo root serves both api-server and the Vite build.
#############################################################################

NODE_ENV=development
LOG_LEVEL=debug

# ── api-server ─────────────────────────────────────────────────────────────
PORT=3000
# Served at /media. home/ holds the home page images, portfolio/<category>/
# holds portfolio photos. Relative paths resolve against the repo root.
MEDIA_DIR=./media
# Host path bind-mounted into the app container at MEDIA_DIR.
HOST_MEDIA_DIR=./media
# true in production so Express serves the built SPA; false locally so Vite
# keeps HMR.
SERVE_STATIC=false

# ── Web (Vite) ─────────────────────────────────────────────────────────────
WEB_PORT=5173
BASE_PATH=/
API_PROXY_TARGET=http://127.0.0.1:3000
CAL_URL=https://cal.com/capturesbycapri/appointment
