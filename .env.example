#############################################################################
# captures-by-capri — copy to .env and fill in.
#
# One .env at the repo root serves both api-server and the Vite build.
# api-server loads it via src/env.ts (dotenv + zod validation).
# vite.config.ts loads it itself, because Vite reads process.env at
# config-evaluation time in a separate process.
#
# In production, systemd's EnvironmentFile takes precedence (dotenv is loaded
# with override: false), so these act as defaults.
#############################################################################

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
# `debug` also switches on Drizzle SQL query logging.
LOG_LEVEL=debug

# ── api-server ─────────────────────────────────────────────────────────────
PORT=3000
# 5433 is the host port docker-compose maps Postgres to.
DATABASE_URL=postgres://capri:capri@localhost:5433/capri

# ── Web (Vite) ─────────────────────────────────────────────────────────────
# WEB_PORT, not PORT: PORT belongs to api-server and both read this same file.
WEB_PORT=5173
BASE_PATH=/
API_PROXY_TARGET=http://127.0.0.1:3000
CAL_URL=https://cal.com/capturesbycapri/appointment

# ── Admin auth ─────────────────────────────────────────────────────────────
# Single shared password; there is no user table. Minimum 12 characters.
ADMIN_PASSWORD=
# Signs the session cookie. Minimum 32 chars — generate with:
#   openssl rand -hex 32
# Without this the cookie would be forgeable.
SESSION_SECRET=
SESSION_TTL_HOURS=12

# ── Static assets ──────────────────────────────────────────────────────────
# Mirror of the ex-Supabase "Photos" bucket, served at /media.
# On the LXC: /srv/capri/media
MEDIA_DIR=./media
# true in production so Express serves the built SPA. Locally false, so Vite
# keeps ownership of HMR.
SERVE_STATIC=false
# Defaults to artifacts/captures-by-capri/dist/public; override only if needed.
# WEB_DIST_DIR=

# ── Scheduler ──────────────────────────────────────────────────────────────
# true only on the LXC. Off locally so testing never sends real messages.
ENABLE_SCHEDULER=false
#
# MUST run at most once per day. The reminder windows (T-3d, T-2d, T-1d) are
# each a full 24-hour band and there is no "already sent" marker in the schema,
# so an hourly schedule would send every reminder up to 24 times — real money
# and real annoyance. Hourly resolution would need a schema change
# (a last_reminder_sent_at column), not a config change.
CRON_SCHEDULE=0 14 * * *
CRON_TIMEZONE=America/Chicago

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# From: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ── Cal.com ────────────────────────────────────────────────────────────────
CALCOM_API_KEY=
# Set the SAME value in the Cal.com webhook UI. Without it the webhook endpoint
# rejects every request — it fails closed on purpose, because this is a public
# write path that creates customers and appointments.
CAL_WEBHOOK_SECRET=

# ── Twilio (SMS) ───────────────────────────────────────────────────────────
# Leave blank locally: sendSms() degrades to a warn-and-skip, so tests can run
# the notification paths without sending anything.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Where booking-request alerts and scheduler warnings go.
ADMIN_PHONE_NUMBER=

# ── Resend (email) ─────────────────────────────────────────────────────────
# Also degrades to warn-and-skip when blank.
RESEND_API_KEY=
